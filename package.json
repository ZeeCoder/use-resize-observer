{
  "name": "use-resize-observer",
  "version": "10.0.0-alpha.3",
  "packageManager": "pnpm@10.34.1",
  "description": "A React hook that allows you to use a ResizeObserver to measure an element's size.",
  "keywords": [
    "react",
    "hook",
    "react hook",
    "resize observer",
    "resize observer hook",
    "resize observer react hook",
    "use-resize-observer",
    "useresizeobserver",
    "resize hook",
    "size hook",
    "container query",
    "css in js",
    "measure",
    "size",
    "resize"
  ],
  "license": "MIT",
  "author": "Viktor Hubert <contact@hubertviktor.com>",
  "repository": "git@github.com:ZeeCoder/use-resize-observer.git",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "format": "oxfmt",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:types": "tsc -p tests/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "check:size": "size-limit",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:e2e": "node scripts/e2e-build.mjs && wdio run tests/e2e/wdio.conf.ts",
    "test": "pnpm build && pnpm check:format && pnpm check:lint && pnpm check:types && pnpm check:size && pnpm test:node && pnpm test:pack",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@wdio/browserstack-service": "^9.33.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/static-server-service": "^9.29.1",
    "@wdio/types": "^9.29.1",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.52.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.8",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0",
    "webdriverio": "^9.30.0"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "oxfmt --write"
    ]
  }
}
